#!/usr/bin/env Rscript

show_help <- function() {
    cat("Usage: Rscript gen_bartonella_prevalence <qza_folder> <metadata_path> [output_dir]\n\n")
    cat("Arguments:\n")
    cat("  qza_folder      QIIME2 .qzaファイルが格納されたフォルダのパス\n")
    cat("  metadata_path   メタデータファイルのパス (TSV, sample_name列とspecies列が必要)\n")
    cat("  output_dir      出力先ディレクトリ (デフォルト: カレントディレクトリ)\n\n")
    cat("Options:\n")
    cat("  --help, -h      このヘルプメッセージを表示して終了する\n\n")
    cat("Outputs:\n")
    cat("  bartonella_prevalence_by_species.csv  種ごとのBartonella保有率・陽性サンプルの丸め込み後占有率平均値/中央値/最頻値\n")
    cat("  bartonella_prevalence_by_species.svg  種ごとのBartonella保有率・陽性サンプルの丸め込み後占有率平均値/中央値/最頻値 棒グラフ\n")
    quit(status = 0)
}

args <- commandArgs(trailingOnly = TRUE)
if (length(args) > 0 && (args[1] == "--help" || args[1] == "-h")) {
    show_help()
}

library(conflicted)
library(tidyverse)
library(phyloseq)
library(dplyr)

project_root <- Sys.getenv("GRAPH_WRITING_ROOT", unset = ".")
source(file.path(project_root, "src/q2obj.r"))
source(file.path(project_root, "src/df_modify.r"))

conflict_prefer("filter", "dplyr")
conflict_prefer("lag", "dplyr")


# 0.1%刻みで占有率を丸める
round_ratio_to_0_1pct <- function(x) {
    step <- 0.001
    rounded <- floor(x / step + 0.5) * step
    pmin(pmax(rounded, 0), 1)
}

# 陽性サンプルだけに限定し、占有率を丸め込んでから平均値を計算
mean_rounded_positive_ratio <- function(x) {
    positive <- x[!is.na(x) & x > 0]
    if (length(positive) == 0) {
        return(NA_real_)
    }

    rounded_positive <- round_ratio_to_0_1pct(positive)
    round_ratio_to_0_1pct(mean(rounded_positive))
}

# 陽性サンプルだけに限定し、占有率を丸め込んでから中央値を計算
median_rounded_positive_ratio <- function(x) {
    positive <- x[!is.na(x) & x > 0]
    if (length(positive) == 0) {
        return(NA_real_)
    }

    rounded_positive <- round_ratio_to_0_1pct(positive)
    round_ratio_to_0_1pct(median(rounded_positive))
}

# 陽性サンプルだけに限定し、占有率を丸め込んでから最頻値を計算
mode_rounded_positive_ratio <- function(x) {
    positive <- x[!is.na(x) & x > 0]
    if (length(positive) == 0) {
        return(NA_real_)
    }

    rounded_positive <- round_ratio_to_0_1pct(positive)
    frequency <- table(rounded_positive)
    as.numeric(names(frequency)[which.max(frequency)])
}

# speciesごとの保有率を計算
calculate_prevalence <- function(ratio_df, sample_info) {
    ratio_df %>%
        left_join(sample_info, by = "SampleID") %>%
        filter(!is.na(species)) %>%
        group_by(species) %>%
        summarise(
            n = n(),
            detected = sum(Ratio > 0),
            prevalence = detected / n,
            mean_ratio = mean(Ratio, na.rm = TRUE),
            sd_ratio = sd(Ratio, na.rm = TRUE),
            positive_rounded_mean_ratio = mean_rounded_positive_ratio(Ratio),
            positive_rounded_median_ratio = median_rounded_positive_ratio(Ratio),
            positive_rounded_mode_ratio = mode_rounded_positive_ratio(Ratio),
            .groups = "drop"
        ) %>%
        arrange(desc(prevalence))
}


# 種ごとの保有率棒グラフを作成
plot_prevalence <- function(prevalence_df, title = "Bartonella保有率（種別）") {
    # 表示用にアンダースコアをスペースに置換
    plot_df <- prevalence_df %>%
        mutate(
            species_label = gsub("_", " ", species),
            species_label = factor(species_label, levels = gsub("_", " ", species)),
            mean_label = if_else(
                is.na(positive_rounded_mean_ratio),
                "NA",
                sprintf("%.1f%%", positive_rounded_mean_ratio * 100)
            ),
            median_label = if_else(
                is.na(positive_rounded_median_ratio),
                "NA",
                sprintf("%.1f%%", positive_rounded_median_ratio * 100)
            ),
            mode_label = if_else(
                is.na(positive_rounded_mode_ratio),
                "NA",
                sprintf("%.1f%%", positive_rounded_mode_ratio * 100)
            )
        )

    ggplot(plot_df, aes(x = species_label, y = prevalence, fill = species_label)) +
        geom_col(width = 0.7) +
        geom_text(
            aes(label = sprintf(
                "n=%d\n%d/%d\n%.1f%%\n平均値=%s\n中央値=%s\n最頻値=%s",
                n, detected, n, prevalence * 100, mean_label, median_label, mode_label
            )),
            vjust = -0.2, size = 2.8, lineheight = 0.82, fontface = "bold"
        ) +
        scale_y_continuous(
            limits = c(0, 1.6),
            breaks = seq(0, 1, by = 0.25),
            labels = scales::percent_format()
        ) +
        labs(
            title = title,
            x = "Species",
            y = "Bartonella prevalence"
        ) +
        theme_bw() +
        theme(
            plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
            axis.text.x = element_text(angle = 45, hjust = 1, size = 10),
            axis.text.y = element_text(size = 10),
            axis.title = element_text(size = 12, face = "bold"),
            legend.position = "none"
        )
}


# --- Main ---

if (length(args) < 2) {
    stop("Usage: Rscript gen_bartonella_prevalence <qza_folder> <metadata_path> [output_dir]\nUse --help for more information.")
}
qza_folder <- args[1]
metadata_path <- args[2]
output_dir <- if (length(args) >= 3) args[3] else "."

if (!dir.exists(output_dir)) dir.create(output_dir, recursive = TRUE)

# phyloseqオブジェクト構築 (OTU + Taxonomy)
ps <- load_q2obj(qza_folder) %>%
    tax_fix() %>%
    tax_fix(unknowns = c("uncultured"))

# メタデータ読み込み
otu_samples <- sample_names(ps)
sample_info <- read_tsv(metadata_path, comment = "", show_col_types = FALSE) %>%
    rename_with(~"SampleID", .cols = 1) %>%
    filter(!str_detect(.data[["SampleID"]], "^#q2:types|^categorical|^numeric")) %>%
    filter(SampleID %in% otu_samples) %>%
    select(SampleID, species)

df <- ps_to_df(ps)

# 種ごとのBartonella保有率を計算
prevalence_result <- get_ratio(df, "Bartonella") %>%
    calculate_prevalence(sample_info)

# CSV出力
write_csv(prevalence_result, file.path(output_dir, "bartonella_prevalence_by_species.csv"))

# 棒グラフ出力
prevalence_result %>%
    plot_prevalence() %>%
    ggsave(
        file.path(output_dir, "bartonella_prevalence_by_species.svg"),
        plot = .,
        width = 10, height = 6, dpi = 600
    )

cat("Done.\n")
