    cat("Options:\n")
    cat("  --help, -h              このヘルプメッセージを表示して終了する\n\n")
    cat("Outputs:\n")
    cat("  relative_abundance_comparison.svg  箱ひげ図 + エラーバー付き散布図\n")
    cat("  relative_abundance_stats.csv       各Genusの統計情報 (n, mean, sd, se, detection_rate)\n")
    quit(status = 0)
}

