show_help <- function() {
    cat("Usage: Rscript gen_scatter <qza_folder> <metadata_path_or_folder> [output_dir]\n\n")
    cat("Arguments:\n")
    cat("  qza_folder              QIIME2 .qzaファイルが格納されたフォルダのパス\n")
    cat("  metadata_path_or_folder メタデータファイルまたはフォルダのパス\n")
